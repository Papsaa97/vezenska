# ─────────────────────────────────────────────────────────────────────────────
# Akademie VS ČR – proměnné prostředí
#
# Zkopíruj tento soubor jako .env.local a vyplň skutečné hodnoty.
# .env* je v .gitignore — NIKDY necommituj soubor se skutečnými hodnotami.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (povinné) ───────────────────────────────────────────────────────
# Dashboard -> Project Settings -> API
# Prefix VITE_ znamená, že se hodnota vkládá do veřejného klientského bundlu.
# U anon klíče je to v pořádku (je určen ke zveřejnění a chrání ho RLS);
# service_role klíč sem NIKDY nepatří.
VITE_SUPABASE_URL=https://vas-projekt.supabase.co
VITE_SUPABASE_ANON_KEY=

# ── Ochrana proti robotům (CAPTCHA) ──────────────────────────────────────────
# Vyplňte POUZE tehdy, když je v Supabase zapnutá ochrana CAPTCHA
# (Authentication → Attack Protection → Enable CAPTCHA protection).
#
# Obě hodnoty musí odpovídat poskytovateli nastavenému v Supabase. Když se
# rozejdou, server přihlášení odmítne. Prázdné hodnoty znamenají, že se
# ověření nezobrazí a token se neposílá — tedy chování jako bez CAPTCHA.
#
# POZOR na směr: mít zapnutou ochranu v Supabase a NEmít vyplněné tyhle
# proměnné znamená, že se nikdo nepřihlásí.
#
# VITE_CAPTCHA_PROVIDER: hcaptcha nebo turnstile
# VITE_CAPTCHA_SITEKEY: veřejný Sitekey od poskytovatele (NE Secret key —
#   ten patří výhradně do Supabase a do repozitáře nikdy).
VITE_CAPTCHA_PROVIDER=
VITE_CAPTCHA_SITEKEY=

# ── Synchronizační účet (jen pro scripts/reclassifyAndSync.ts) ───────────────
# Používá se výhradně při ručním spuštění synchronizačního skriptu, nikdy
# v běžící aplikaci. BEZ prefixu VITE_ — do klientského bundlu to nepatří.
#
# Účet potřebuje roli lektor nebo admin v public.profiles, jinak RLS zápis do
# quiz_questions odmítne. Bez vyplněných hodnot se skript odmítne spustit.
SYNC_AGENT_EMAIL=
SYNC_AGENT_PASSWORD=

# ── Bootstrap správce (nepovinné) ────────────────────────────────────────────
# Čárkami oddělený seznam e-mailů, kterým se v rozhraní zobrazí role správce
# i v případě, že ji ještě nemají nastavenou v databázi. Slouží jen k tomu, aby
# se vlastník aplikace nezamkl venku; o skutečném přístupu k datům rozhodují
# výhradně RLS politiky a role v tabulce public.profiles.
# Hodnota skončí ve veřejném bundlu — nepiš sem nic, co nemá být vidět.
VITE_ADMIN_EMAILS=

# ── Gemini / AI asistent (nepovinné) ─────────────────────────────────────────
# POZOR: kvůli prefixu VITE_ se tento klíč zveřejní v klientském JavaScriptu.
# Necháš-li prázdné, aplikace si klíč vyžádá od uživatele a uloží ho jen do
# jeho prohlížeče (model "vlastní klíč") — to je bezpečnější varianta.
VITE_GEMINI_API_KEY=

# ── Autonoma (end-to-end testy; nepovinné, v produkci nechat vypnuté) ────────
# Endpoint /api/autonoma zakládá a maže REÁLNÉ řádky v databázi. Je vypnutý,
# dokud není AUTONOMA_ENABLED=true A zároveň vyplněné všechny proměnné níže.
# V produkci musí zůstat vypnutý — zapínej jen lokálně nebo v preview prostředí.
# Tyto proměnné nemají prefix VITE_, takže se do klientského bundlu nedostanou.
AUTONOMA_ENABLED=false
AUTONOMA_TEST_EMAIL=
AUTONOMA_TEST_PASSWORD=
# Vygeneruj si vlastní: openssl rand -hex 32
AUTONOMA_SHARED_SECRET=
AUTONOMA_SIGNING_SECRET=
